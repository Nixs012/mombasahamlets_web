# ===================================================================
# Mombasa Hamlets FC — Environment Configuration (Sandbox)
# ===================================================================
# Copy this file to .env and fill in your SANDBOX credentials.
# NEVER COMMIT THE REAL .env FILE — it is git-ignored.
# DO NOT add live/production keys to this file.

# --- Application ---
