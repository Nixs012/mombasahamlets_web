BASE_URL=
JWT_SECRET=mombasahamlets_secure_secret_key_change_this_in_prod

# --- Database ---
DB_HOST=127.0.0.1
DB_NAME=mombasa_hamlets
DB_USER=root
DB_PASSWORD=

