# =================================
# Mombaş Hamlets — Environment Config (Template)
# =================================
# Copy this file to .env and fill in real values for your environment.
# The .env file is ignored by Git for security.

# ── Application ──────────────────
APP_ENV=development

# ── Database ────────────────────
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ── JWT Secret ──────────────────
# Generate a long random string for production, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── Paystack ────────────────────
# Get these from https://dashboard.paystack.com
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# ── Shipping Rates (KES) ─────────
SHIPPING_MOMBASA=150
SHIPPING_OUTSIDE=300

# ── Paystack Callback ───────────
PAYSTACK_VERIFY_URL=http://your-domain.com/backend/api/verify_paystack.php
